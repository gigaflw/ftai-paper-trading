{
  // 插件后端；前端（src/client）由 tsconfig.client.json 检查、Vite 构建
  "extends": "@ftai/plugin-sdk/tsconfig.host.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "lib",
    // 共享层（core/contract/store/service/data/agent）从 dsh 版插件按 v0.8.0 原样同步，
    // 那边 tsconfig 未开这两项；这里关掉以保持同一份源码能直接编译。
    "exactOptionalPropertyTypes": false,
    "noUncheckedIndexedAccess": false
  },
  "include": ["src"],
  "exclude": ["src/client"]
}
